{
  "name": "movieroulette",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint \"static/js/**/*.js\"",
    "lint:css": "stylelint \"static/css/**/*.css\"",
    "cpd": "jscpd .",
    "test": "pytest tests",
    "test:js": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "lint-staged": "^17.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "static/js/**/*.js": "eslint",
    "static/css/**/*.css": "stylelint",
    "**/*.py": "ruff check"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "custom-property-pattern": null,
      "color-function-notation": "legacy",
      "alpha-value-notation": "number",
      "declaration-block-single-line-max-declarations": null,
      "declaration-empty-line-before": null,
      "rule-empty-line-before": null,
      "at-rule-empty-line-before": null,
      "comment-empty-line-before": null
    }
  },
  "jscpd": {
    "threshold": 5,
    "reporters": [
      "console"
    ],
    "ignore": [
      "node_modules",
      ".venv",
      "package-lock.json",
      ".git"
    ],
    "absolute": true,
    "gitignore": true
  }
}
